      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [-480, 0]
    },
    {
      "parameters": {
        "cwd": "/tmp",
        "command": "=VIDEO_ID=\"{{ $json.video_id }}\"; yt-dlp --js-runtimes deno:/home/YOUR_USER/.deno/bin/deno --cookies /home/YOUR_USER/.config/yt-dlp-cookies.txt --write-auto-sub --skip-download --sub-langs en --sub-format vtt --no-write-playlist-metafiles --quiet -o \"/tmp/yt_${VIDEO_ID}\" \"https://www.youtube.com/watch?v=${VIDEO_ID}\" 2>&1; VTT_FILE=$(ls /tmp/yt_${VIDEO_ID}*.vtt 2>/dev/null | head -1); if [ -n \"$VTT_FILE\" ]; then cat \"$VTT_FILE\"; rm -f \"$VTT_FILE\"; else echo \"NO_TRANSCRIPT_FOUND\"; fi"
      },
      "id": "a1b2c3d4-0005-0005-0005-000000000005",
      "name": "Get Transcript",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [-240, 0],
      "credentials": {
        "sshPrivateKey": {
          "id": "REPLACE_WITH_SSH_CREDENTIAL_ID",
          "name": "VPS SSH"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "id": "cond-004",
              "leftValue": "={{ $json.stdout }}",
              "rightValue": "NO_TRANSCRIPT_FOUND",
              "operator": {
                "type": "string",
                "operation": "notContains"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-0006-0006-0006-000000000006",
      "name": "Transcript Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "jsCode": "const stdout = $input.first().json.stdout || '';\nconst videoData = $('Loop Over Items').item.json;\n\n// Strip VTT formatting\nconst lines = stdout.split('\\n');\nconst textLines = [];\n\nfor (const line of lines) {\n  const trimmed = line.trim();\n  if (trimmed.startsWith('WEBVTT') || trimmed.startsWith('Kind:') || trimmed.startsWith('Language:')) continue;\n  if (trimmed.includes('-->')) continue;\n  if (trimmed === '' || /^\\d+$/.test(trimmed)) continue;\n  const cleaned = trimmed.replace(/<[^>]+>/g, '').trim();\n  if (cleaned) textLines.push(cleaned);\n}\n\n// Deduplicate consecutive identical lines (common in auto-captions)\nconst deduped = textLines.filter((line, i) => i === 0 || line !== textLines[i - 1]);\nconst transcript = deduped.join(' ');\n\nconst today = new Date().toISOString().slice(0, 10);\nconst title = videoData.title || videoData.video_id;\nconst channel = videoData.channel || 'Unknown';\nconst videoId = videoData.video_id;\n\n// Normalize category to a lens slug (videos.csv now carries slugs; this\n// also maps any leftover display names like 'PKA \\u2192 Claude & Tools (85 videos)')\nlet category = String(videoData.category || '').toLowerCase()\n  .replace(/^pka\\s*\\u2192\\s*/, '')\n  .replace(/\\(\\d+\\s*videos?\\)/, '')\n  .trim()\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-|-$/g, '');\nconst SLUG_MAP = { 'ai-systems': 'ai-systems', 'claude-tools': 'ai-systems', 'ventures': 'ventures', 'content-brand': 'content-brand', 'web-dev': 'web-dev', 'learning': 'learning', 'travel': 'travel' };\ncategory = SLUG_MAP[category] || category || 'uncategorized';\n\nconst slug = title\n  .toLowerCase()\n  .replace(/[^a-z0-9]+/g, '-')\n  .replace(/^-|-$/g, '')\n  .substring(0, 60);\n\nconst content = ['---', `title: ${title.replace(/:/g, ' -')}`, `channel: ${channel.replace(/:/g, ' -')}`, `category: ${category}`, `url: https://www.youtube.com/watch?v=${videoId}`, `captured: ${today}`, 'tier: autofile', 'source: youtube-batch', '---', '', `# ${title}`, '', '## Transcript', '', transcript, ''].join('\\n');\n\nconst filename = `${today}-${slug}.md`;\n\nreturn [{ json: { filename, content, originalName: filename, video_id: videoId } }];"
      },
      "id": "a1b2c3d4-0007-0007-0007-000000000007",
      "name": "Format Transcript .md",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, -80]
    },
    {
      "parameters": {
        "jsCode": "const content = $input.item.json.content;\nconst filename = $input.item.json.filename;\nconst originalName = $input.item.json.originalName;\n\nreturn [{\n  json: { filename, originalName },\n  binary: {\n    data: {\n      data: Buffer.from(content, 'utf-8').toString('base64'),\n      mimeType: 'text/markdown',\n      fileName: filename,\n      fileExtension: 'md'\n    }\n  }\n}];"
      },
      "id": "a1b2c3d4-0008-0008-0008-000000000008",
      "name": "Convert to Binary",
